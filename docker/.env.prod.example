# Copie para docker/.env.prod no servidor e NÃO versione o arquivo real.

APP_VERSION=1.0.0

# Imagens .NET fixadas para reprodutibilidade.
DOTNET_SDK_TAG=10.0.401
DOTNET_RUNTIME_TAG=10.0.12

# SQL Server Express para produção de portfólio/baixo volume.
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_SQL#2026!

RABBITMQ_USER=emailsender_prod
RABBITMQ_PASSWORD=CHANGE_ME_Strong_Rabbit#2026!

# API Key longa e aleatória (mínimo de 32 bytes).
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_API_KEY_AT_LEAST_32_BYTES

# Amazon SES SMTP
AWS_REGION=us-east-1
SES_SMTP_USERNAME=CHANGE_ME
SES_SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=noreply@seu-dominio.com
SMTP_FROM_NAME=EmailSender

# Worker
WORKER_PREFETCH=10
RETRY_1_SECONDS=60
RETRY_2_SECONDS=300

# HTTPS / Caddy
DOMAIN=api.seu-dominio.com
ACME_EMAIL=admin@seu-dominio.com

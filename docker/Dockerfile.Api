# syntax=docker/dockerfile:1

ARG DOTNET_SDK_TAG=10.0.401
ARG ASPNET_RUNTIME_TAG=10.0.12

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_TAG} AS build
WORKDIR /src

COPY ["src/EmailSender.Domain/EmailSender.Domain.csproj", "src/EmailSender.Domain/"]
COPY ["src/EmailSender.Application/EmailSender.Application.csproj", "src/EmailSender.Application/"]
COPY ["src/EmailSender.Infrastructure/EmailSender.Infrastructure.csproj", "src/EmailSender.Infrastructure/"]
COPY ["src/EmailSender.Api/EmailSender.Api.csproj", "src/EmailSender.Api/"]

RUN dotnet restore "src/EmailSender.Api/EmailSender.Api.csproj"

COPY . .
RUN dotnet publish "src/EmailSender.Api/EmailSender.Api.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_RUNTIME_TAG} AS final
WORKDIR /app
EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "EmailSender.Api.dll"]
